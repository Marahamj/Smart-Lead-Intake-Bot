    {
      "parameters": {
        "language": "pythonNative",
        "pythonCode": "seen_emails = set()\nclean_items = []\n\nfor item in _items:\n    json_data = item.get('json', {})\n    \n    # 1. تفكيك body لو كانت البيانات من Webhook\n    body_data = json_data.get('body', {}) if isinstance(json_data.get('body'), dict) else {}\n    \n    # 2. تجميع وحصد الحقول بغض النظر عن المصدر (Gmail أو Webhook)\n    name = json_data.get('name') or body_data.get('name', '')\n    email = json_data.get('email') or body_data.get('email', '')\n    phone = json_data.get('phone') or body_data.get('phone', '')\n    company = json_data.get('company') or body_data.get('company', '')\n    message = json_data.get('message') or json_data.get('snippet') or body_data.get('message', '')\n    source = json_data.get('source') or body_data.get('source', 'unknown')\n    received_at = json_data.get('received_at') or body_data.get('received_at', '')\n\n    clean_email = str(email).strip().lower()\n\n    # 3. فحص التكرار بناءً على الإيميل\n    if clean_email:\n        if clean_email in seen_emails:\n            continue  # يتجاهل الإيميل المكرر تماماً\n        seen_emails.add(clean_email)\n\n    # 4. بناء عنصر موحد وبسيط جداً بدون أجهزة متداخلة\n    unified_item = {\n        \"name\": name,\n        \"email\": clean_email,\n        \"phone\": phone,\n        \"company\": company,\n        \"service_interest\": json_data.get('service_interest') or body_data.get('service_interest', ''),\n        \"message\": message,\n        \"source\": source,\n        \"received_at\": received_at\n    }\n\n    clean_items.append({'json': unified_item})\n\nreturn clean_items"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
